# Copy to .env at the repo root. Every value below is optional in development.

# Leave empty in dev: the API starts a local MongoDB (data kept in apps/api/.data).
# Production: a MongoDB Atlas connection string.
MONGODB_URI=

# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The owner account is created from these on first boot, when no admin exists.
ADMIN_EMAIL=admin@sangha.local
ADMIN_PASSWORD=ChangeMe123!

PORT=4000
# Where uploaded images are stored (a persistent disk/volume in production).
UPLOAD_DIR=uploads

# Optional email confirmations (registration details, payment received). Without SMTP_URL no email is sent.
# BREVO_API_KEY=xkeysib-...   (Brevo's HTTPS API: use this on hosts that block SMTP ports, like Render's free plan)
# SMTP_URL=smtp://user:password@smtp.example.com:587
# MAIL_FROM=Kannada Sangha <hello@yoursangha.lu>
# Public address of the site, used for the status links inside emails.
# PUBLIC_URL=https://yoursangha.lu
