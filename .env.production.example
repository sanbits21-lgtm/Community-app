# Copy to .env ON THE SERVER (never commit the real one) and fill in every line.

# Your domain, without https:// (Caddy gets the certificate for it).
DOMAIN=yoursangha.lu
# Used for the links inside emails.
PUBLIC_URL=https://yoursangha.lu

# At least 32 characters; the app refuses to start with less. Generate: openssl rand -hex 48
JWT_SECRET=

# The owner account is created from these the first time the app starts.
# The password needs 12+ characters and may not be an easy word (the app refuses to start otherwise).
ADMIN_EMAIL=you@yoursangha.lu
ADMIN_PASSWORD=

# Optional email (Brevo shown). Without SMTP_URL no email is sent and everything else still works.
# SMTP_URL=smtp://YOUR_BREVO_LOGIN:YOUR_SMTP_KEY@smtp-relay.brevo.com:587
# MAIL_FROM=Kannada Sangha <hello@yoursangha.lu>

# Housekeeping (optional; these are the defaults).
# Photos and screenshots that nothing uses are deleted after this many days:
# UPLOAD_GRACE_DAYS=7
# Screenshots of verified/rejected payments are deleted after this many days (privacy):
# PROOF_RETENTION_DAYS=30
